<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TSL.UI</RootNamespace>
    <AssemblyName>TSL.UI</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!--
      Microsoft.NET.Sdk.WindowsDesktop ships the WPF + WinForms build
      toolchain in-box. Setting UseWPF + UseWindowsForms enables the
      default <Page> globbing for ``**/*.xaml`` and triggers .g.cs
      InitializeComponent generation under any modern dotnet SDK,
      removing the legacy WinFX-targets-on-MSBuildExtensionsPath
      dependency that the previous Microsoft.NET.Sdk + manual import
      pattern relied on. (See cycle history pre-2026-05-01: that path
      did not exist on VS 2022 Community installs lacking the legacy
      WinFX workload, breaking ``dotnet build`` under .NET 10 SDK.)
    -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!--
    SDK auto-imports the WPF framework references (PresentationFramework,
    PresentationCore, WindowsBase, System.Xaml) and the WinForms
    references (System.Windows.Forms, WindowsFormsIntegration). We only
    need to add references that aren't part of the default WPF/WinForms
    set:
  -->
  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>

  <!--
    XAML files under Views/ are auto-globbed as <Page> by the
    WindowsDesktop SDK; their *.xaml.cs files auto-link as code-behind.
    No manual <Page> or <Compile Update DependentUpon> entries needed.
  -->

</Project>
