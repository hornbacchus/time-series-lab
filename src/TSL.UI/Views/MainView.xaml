<UserControl x:Class="TSL.UI.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TSL.UI.ViewModels"
             xmlns:views="clr-namespace:TSL.UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="700"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- ── Color palette ──────────────────────────────────────── -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#1B3A5C" />
        <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1976D2" />
        <SolidColorBrush x:Key="ContentBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#1E2A3A" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#2C3E50" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#B0BEC5" />
        <SolidColorBrush x:Key="SidebarActiveTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#757575" />
        <SolidColorBrush x:Key="StatusBarBrush" Color="#263238" />

        <!-- ── Nav button style ───────────────────────────────────── -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarActiveTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataTemplate mapping: ViewModel -> View ────────────── -->
        <DataTemplate DataType="{x:Type vm:TechniqueExplorerViewModel}">
            <views:TechniqueExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunViewModel}">
            <views:RunView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecommenderViewModel}">
            <views:RecommenderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataReadinessViewModel}">
            <views:DataReadinessView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UdfBrowserViewModel}">
            <views:UdfBrowserView />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ── Top status bar ─────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource StatusBarBrush}"
                Padding="10,6" Height="32">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="TSL"
                           FontWeight="Bold" FontSize="12"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SelectionStatus}"
                           Foreground="{StaticResource SidebarTextBrush}"
                           FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ── Navigation sidebar ─────────────────────────────────── -->
        <Border DockPanel.Dock="Left" Background="{StaticResource SidebarBrush}"
                Width="140">
            <DockPanel LastChildFill="True">

                <!-- App title in sidebar -->
                <TextBlock DockPanel.Dock="Top" Text="Time Series Lab"
                           Foreground="{StaticResource HeaderTextBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="10,12,10,4" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Preset, StringFormat='Preset: {0}'}"
                           Foreground="{StaticResource SidebarTextBrush}"
                           FontSize="10" Margin="10,0,10,12" />

                <Separator DockPanel.Dock="Top" Background="#37474F" Margin="8,0" />

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateExplorerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F50D;" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Explorer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateRecommenderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2728;" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Recommender" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateDataReadinessCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2705;" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Data Readiness" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateUdfBrowserCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="fx" FontSize="12" FontWeight="Bold" Margin="2,0,6,0"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="UDF Browser" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Background="#37474F" Margin="8,8" />

                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2699;" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Spacer -->
                <Border />

            </DockPanel>
        </Border>

        <!-- ── Content area ───────────────────────────────────────── -->
        <DockPanel LastChildFill="True">

            <!-- View title bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}"
                    Padding="12,8" Height="36">
                <TextBlock Text="{Binding CurrentViewTitle}"
                           Foreground="{StaticResource HeaderTextBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Content presenter switches based on CurrentView DataTemplate -->
            <ContentPresenter Content="{Binding CurrentView}" />

        </DockPanel>

    </DockPanel>

</UserControl>
