<UserControl x:Class="TSL.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignWidth="260" d:DesignHeight="650"
             Background="#FFFFFF">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1976D2" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#757575" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="CategoryBgBrush" Color="#F8F9FA" />

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#424242" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8">

            <!-- ── Engine ─────────────────────────────────────────── -->
            <TextBlock Text="ENGINE" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="Engine Path" Style="{StaticResource SettingLabel}" />
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Browse" Padding="8,4"
                        FontSize="11" Margin="6,0,0,0"
                        Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Cursor="Hand"
                        Command="{Binding BrowseEnginePathCommand}" />
                <TextBox Text="{Binding EnginePath, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="11" FontFamily="Consolas"
                         BorderBrush="{StaticResource BorderBrush}" />
            </DockPanel>

            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Engine version: " FontSize="11" Foreground="#424242" />
                <TextBlock Text="{Binding EngineVersion}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
            </DockPanel>

            <Button Content="Check Engine" Style="{StaticResource OutlineButton}"
                    Command="{Binding CheckEngineCommand}"
                    HorizontalAlignment="Left" Padding="10,5" FontSize="11"
                    Margin="0,0,0,8" />

            <!-- ── Defaults ───────────────────────────────────────── -->
            <TextBlock Text="DEFAULTS" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="Default Preset" Style="{StaticResource SettingLabel}" />
            <ComboBox Margin="0,0,0,8" FontSize="12" Padding="6,4"
                      SelectedItem="{Binding DefaultPreset}">
                <sys:String>Fast</sys:String>
                <sys:String>Balanced</sys:String>
                <sys:String>Thorough</sys:String>
            </ComboBox>

            <CheckBox Content="Auto-detect frequency" IsChecked="{Binding AutoDetectFrequency}"
                      FontSize="12" Margin="0,0,0,6" />
            <CheckBox Content="Show formula hints in IntelliSense" IsChecked="{Binding ShowFormulaHints}"
                      FontSize="12" Margin="0,0,0,6" />
            <CheckBox Content="Create separate output sheets" IsChecked="{Binding CreateSeparateSheets}"
                      FontSize="12" Margin="0,0,0,12" />

            <!-- ── Actions ────────────────────────────────────────── -->
            <TextBlock Text="ACTIONS" Style="{StaticResource SectionHeader}" />

            <Button Content="Reset to Defaults" Style="{StaticResource OutlineButton}"
                    Command="{Binding ResetDefaultsCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,12" />

            <!-- ── Status ─────────────────────────────────────────── -->
            <Border Background="{StaticResource CategoryBgBrush}" CornerRadius="4"
                    Padding="10,8" Margin="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#424242"
                           TextWrapping="Wrap" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
