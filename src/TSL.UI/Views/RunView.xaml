<UserControl x:Class="TSL.UI.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="260" d:DesignHeight="650"
             Background="#FFFFFF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="AccentBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1976D2" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#1B3A5C" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#757575" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="CategoryBgBrush" Color="#F8F9FA" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F44336" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50" />

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D32F2F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Padding="{TemplateBinding Padding}"
                                   TextDecorations="Underline" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8">

            <!-- ── Technique header ───────────────────────────────── -->
            <TextBlock Text="{Binding TechniqueDisplayName}" FontSize="16" FontWeight="Bold"
                       Foreground="#212121" Margin="0,0,0,4" />
            <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,12">
                <Run Text="Preset:" />
                <Run Text="{Binding Preset, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <!-- ── Selection preview ──────────────────────────────── -->
            <TextBlock Text="SELECTION PREVIEW" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6" />
            <Border Background="{StaticResource CategoryBgBrush}" CornerRadius="4"
                    Padding="8" Margin="0,0,0,12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding SeriesPreviews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#424242" />
                                <TextBlock DockPanel.Dock="Right" FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           HorizontalAlignment="Right">
                                    <Run Text="{Binding Length, Mode=OneWay}" />
                                    <Run Text="pts" />
                                    <Run Text=" | " />
                                    <Run Text="{Binding MissingDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Address}" FontSize="10" Margin="8,0"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <TextBlock Text="No series selected. Select data in Excel first."
                                                           FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                                           FontStyle="Italic" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </Border>

            <!-- ── Time index ─────────────────────────────────────── -->
            <TextBlock Text="TIME INDEX" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6" />
            <CheckBox Content="Use time index column" IsChecked="{Binding UseTimeIndex}"
                      FontSize="12" Margin="0,0,0,4" />
            <TextBox Text="{Binding TimeIndexAddress, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding UseTimeIndex}"
                     Padding="6,4" FontSize="11" FontFamily="Consolas"
                     BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,12" />

            <!-- ── Frequency ──────────────────────────────────────── -->
            <TextBlock Text="FREQUENCY" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Left" Text="Detected:" FontSize="11" Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding DetectedFrequency}" FontSize="11" FontWeight="SemiBold"
                           Foreground="#424242" VerticalAlignment="Center" />
            </DockPanel>
            <ComboBox ItemsSource="{Binding AvailableFrequencies}"
                      SelectedItem="{Binding SelectedFrequency}"
                      FontSize="12" Padding="6,4" Margin="0,0,0,16" />

            <!-- ── Technique-specific parameters ──────────────────── -->
            <StackPanel Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="PARAMETERS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <!-- Bool: checkbox with label as content -->
                                <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                          Content="{Binding Label}"
                                          ToolTip="{Binding Description}"
                                          FontSize="12"
                                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />

                                <!-- Dropdown (string with options): label above, combo below -->
                                <StackPanel Visibility="{Binding IsDropdown, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                               Margin="0,0,0,3" ToolTip="{Binding Description}" />
                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding StringValue, Mode=TwoWay}"
                                              FontSize="12" Padding="6,4"
                                              ToolTip="{Binding Description}" />
                                </StackPanel>

                                <!-- Text input (int / string without options): label above, textbox below -->
                                <StackPanel Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                               Margin="0,0,0,3" ToolTip="{Binding Description}" />
                                    <TextBox Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="6,4"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             ToolTip="{Binding Description}" />
                                </StackPanel>

                                <!-- Helper text (description) under non-bool params -->
                                <TextBlock Text="{Binding Description}"
                                           FontSize="10" Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Run / Cancel buttons ───────────────────────────── -->
            <UniformGrid Columns="2" Margin="0,0,0,12">
                <Button Content="Run" Style="{StaticResource AccentButton}"
                        Command="{Binding RunCommand}" Margin="0,0,4,0" />
                <Button Content="Cancel" Style="{StaticResource DangerButton}"
                        Command="{Binding CancelCommand}" Margin="4,0,0,0" />
            </UniformGrid>

            <!-- ── Progress ───────────────────────────────────────── -->
            <StackPanel Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="PROGRESS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6" />

                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#424242"
                               Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" />
                    <TextBlock Text="{Binding ProgressStage}" FontSize="11" Foreground="#424242"
                               FontWeight="SemiBold" />
                </DockPanel>

                <ProgressBar Value="{Binding ProgressPercent}" Height="6" Margin="0,0,0,8"
                             Foreground="{StaticResource AccentBrush}" Background="#E0E0E0" />

                <Border Background="{StaticResource CategoryBgBrush}" CornerRadius="4"
                        Padding="6" MaxHeight="150" Margin="0,0,0,12">
                    <ListBox ItemsSource="{Binding ProgressLog}" BorderThickness="0"
                             Background="Transparent" FontSize="10" FontFamily="Consolas"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                                           Foreground="#616161" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <!-- ── Error ──────────────────────────────────────────── -->
            <Border Background="#FFEBEE" CornerRadius="4" Padding="10,8" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Error" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#C62828"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── Results ────────────────────────────────────────── -->
            <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="RESULTS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6" />

                <Border Background="#E8F5E9" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                    <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="#2E7D32"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Output Sheets:" FontSize="11" FontWeight="SemiBold"
                           Foreground="#424242" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding OutputSheets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}"
                                    Content="{Binding SheetName}"
                                    Command="{Binding DataContext.GoToSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding SheetName}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Reset" Command="{Binding ResetCommand}"
                        Foreground="{StaticResource SubtleTextBrush}"
                        Background="Transparent" BorderThickness="0"
                        FontSize="11" Cursor="Hand" Margin="0,8,0,0"
                        HorizontalAlignment="Left" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
