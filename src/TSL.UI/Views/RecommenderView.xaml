<UserControl x:Class="TSL.UI.Views.RecommenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="260" d:DesignHeight="650"
             Background="#FFFFFF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="AccentBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1976D2" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#1B3A5C" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#757575" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="CategoryBgBrush" Color="#F8F9FA" />
        <SolidColorBrush x:Key="SelectedOptionBrush" Color="#E3F2FD" />
        <SolidColorBrush x:Key="GoldBrush" Color="#FFA000" />
        <SolidColorBrush x:Key="SilverBrush" Color="#78909C" />
        <SolidColorBrush x:Key="BronzeBrush" Color="#8D6E63" />

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BDBDBD" />
                                <Setter Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Option radio-button style -->
        <Style x:Key="OptionButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Ellipse x:Name="Radio" DockPanel.Dock="Left" Width="14" Height="14"
                                         Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="2"
                                         Fill="Transparent" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedOptionBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Radio" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Radio" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FAFAFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ── Step indicator ─────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CategoryBgBrush}"
                Padding="12,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StepDisplay}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Start Over"
                        FontSize="10" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}" Cursor="Hand"
                        HorizontalAlignment="Right" Command="{Binding RestartCommand}" />
            </DockPanel>
        </Border>

        <!-- ── Navigation buttons at bottom ───────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CategoryBgBrush}"
                Padding="12,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <UniformGrid Columns="2">
                <Button Content="Back" Style="{StaticResource OutlineButton}"
                        Command="{Binding BackCommand}" Margin="0,0,4,0" />
                <Button Content="{Binding NextButtonText}" Style="{StaticResource AccentButton}"
                        Command="{Binding NextCommand}" Margin="4,0,0,0" />
            </UniformGrid>
        </Border>

        <!-- ── Question content ───────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsOnQuestion, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="12,12" DataContext="{Binding}">

                <!-- Question text -->
                <TextBlock Text="{Binding CurrentQuestion.QuestionText}"
                           FontSize="16" FontWeight="Bold" Foreground="#212121"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="{Binding CurrentQuestion.HelpText}"
                           FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,16" />

                <!-- Options -->
                <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource OptionButton}"
                                         GroupName="WizardOptions"
                                         Command="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding Value}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#424242" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Results content ────────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsOnResults, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="12,12">

                <TextBlock Text="Recommended Techniques" FontSize="16" FontWeight="Bold"
                           Foreground="#212121" Margin="0,0,0,4" />
                <TextBlock Text="Based on your answers, here are the top recommendations:"
                           FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                           Margin="0,0,0,16" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" CornerRadius="6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="12,10">
                                <DockPanel>
                                    <!-- Rank badge -->
                                    <Border DockPanel.Dock="Left" Width="36" Height="36"
                                            CornerRadius="18" Margin="0,0,10,0"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource AccentBrush}">
                                        <TextBlock Text="{Binding RankDisplay}" Foreground="White"
                                                   FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding TechniqueName}" FontSize="14"
                                                       FontWeight="Bold" Foreground="#212121" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreDisplay}"
                                                       FontSize="10" Foreground="{StaticResource SubtleTextBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding Reason}" FontSize="11"
                                                   Foreground="#616161" TextWrapping="Wrap"
                                                   Margin="0,4,0,8" />

                                        <Button Content="Open in Explorer"
                                                Style="{StaticResource OutlineButton}"
                                                FontSize="11" Padding="10,4"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.OpenTechniqueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TechniqueId}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
