<Window x:Class="TSL.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Series Lab Installer"
        Width="600" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B3A5C">
            <StackPanel VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="Time Series Lab" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Excel Add-in for Advanced Time Series Analysis" FontSize="12" Foreground="#B0C4DE"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="30,20" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Ready to install Time Series Lab."
                       FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15"/>

            <TextBlock Text="This will:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock Text="  1. Copy add-in files to your local app data folder" FontSize="12" Margin="0,0,0,3"/>
            <TextBlock Text="  2. Install the embedded Python engine" FontSize="12" Margin="0,0,0,3"/>
            <TextBlock Text="  3. Register the add-in to auto-load with Excel" FontSize="12" Margin="0,0,0,3"/>
            <TextBlock Text="  4. Install the User Guide document" FontSize="12" Margin="0,0,0,15"/>

            <TextBlock x:Name="InstallPathText" FontSize="11" Foreground="#666" TextWrapping="Wrap"
                       Text="Install path: %LOCALAPPDATA%\TimeSeriesLab\"/>

            <ProgressBar x:Name="ProgressBar" Height="20" Margin="0,15,0,0"
                         Visibility="Collapsed" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ProgressText" FontSize="11" Foreground="#666"
                       Margin="0,5,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,20,0">
            <Button x:Name="UninstallButton" Content="Uninstall" Margin="0,0,10,0"
                    Click="OnUninstall" Padding="15,8" FontSize="12"/>
            <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}"
                    Click="OnInstall"/>
            <Button x:Name="CloseButton" Content="Close" Margin="10,0,0,0"
                    Click="OnClose" Padding="15,8" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
